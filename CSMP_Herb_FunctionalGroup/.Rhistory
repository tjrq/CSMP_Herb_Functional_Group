p_biom_zone_all <-
(p_zone_allherbs_B +  p_zone_brow_B) /
(p_zone_crop_B + p_zone_det_B) /
(p_zone_exc_B + p_zone_scra_B) +
plot_annotation(tag_levels = "a") &
theme(plot.tag = element_text(size = 15))
ggsave("Fig. SX. fg_biom_zone.jpeg",
plot =p_biom_zone_all,
dpi = 600,
height = 10,
width = 10,
units = "in")
