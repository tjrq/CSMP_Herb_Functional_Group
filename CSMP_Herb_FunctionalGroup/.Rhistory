load("Model_Outputs/b_mod_exc.Rdata")
exc_b_nd_zone <-
b_mod_exc |>
emmeans(~ Habitat,
type = "link") |>
gather_emmeans_draws() |>
mutate(Exp_sprich = exp(.value)) |>
dplyr::select(-.chain,
-.iteration,
-.value) |>
summarise_draws(median,
HDInterval::hdi) |>
as.data.frame() |>
filter(Habitat != "passage") |>
mutate(Habitat = factor(Habitat,
levels = c("lagoon",
"inner_reef",
"outer_slope"))) |>
mutate(Habitat = recode(Habitat,
"inner_reef" = "inner reef",
"outer_slope" = "outer reef"))
p_zone_exc_B <-
exc_b_nd_zone |>
ggplot(aes(x = Habitat,
y = median)) +
geom_pointrange(aes(ymin = lower,
ymax = upper),
shape = 21,
size = 1,
fatten = 3,
color = "#E29297",
fill = "#E29297") +
scale_y_continuous(expression(Biomass~(kg.150m^-2)),
limits = c(0, 8),
breaks = seq(0, 8, by = 2)) +
scale_x_discrete(name = "Reef zone") +
theme_classic() +
ggtitle("Excavators") +
theme(axis.title = element_text(size = 15),
axis.text = element_text(size = 12),
plot.title = element_text(size = 18)) +
geom_image(data = tibble(Habitat = 2.8,
median = 7.5),
aes(image = "Images/chlorurus.png"),
size = 0.30)
