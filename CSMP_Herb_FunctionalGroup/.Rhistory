sprich_zone_pair <-
sprich_mod |>
emmeans(~ Habitat,
type = "link") |>
subset(Habitat != "passage") |>
pairs() |>
gather_emmeans_draws() |>
summarise(median_hdci(exp(.value),
.width = c(0.85, 0.95))) |>
as.data.frame()
# plot
p_sprich_zone_pair <-
ggplot() +
geom_pointrange(aes(y = y,
x = contrast,
ymin = ymin,
ymax = ymax),
data = sprich_zone_pair |> filter(.width == 0.85),
linewidth = 1.7) +
geom_pointrange(aes(y = y,
x = contrast,
ymin = ymin,
ymax = ymax),
data = sprich_zone_pair |> filter(.width == 0.95),
pch = 21,
size = 1.2,
fill = "#8AA17D",
linewidth = 0.7) +
geom_hline(yintercept = 1,
linetype = "dashed",
color = "red",
linewidth = 1) +
coord_flip() +
theme_classic() +
scale_x_discrete(name = "Contrast: reef zone",
labels = function(x) gsub("_", " ", x)) +
scale_y_continuous(name = "Scaled effect size",
trans = scales::log2_trans(),
breaks = seq(0, 2, by = 0.5)) +
#ggtitle("Species richness") +
theme(axis.title = element_text(size = 15),
axis.text = element_text(size = 12),
plot.title = element_text(size = 18)) #+
#labs(y = "Scaled effect size", x = "Contrast: reef zone")
p_sprich_zone <-
p_sprich_zone + p_sprich_zone_pair +
plot_annotation(tag_levels = "a") &
theme(plot.tag = element_text(size = 15))
ggsave("Figures/Fig. SX. sprich_zone.jpeg",
plot = p_sprich_zone,
dpi = 600,
height = 5,
width = 8,
units = "in")
rm(list=ls())
gc()
load("Model_Outputs/b_mod_herbs_2.Rdata")
th_b_nd_zone <-
b_mod_herbs_2 |>
emmeans(~ Habitat,
type = "link") |>
gather_emmeans_draws() |>
mutate(Exp_sprich = exp(.value)) |>
dplyr::select(-.chain,
-.iteration,
-.value) |>
summarise_draws(median,
HDInterval::hdi) |>
as.data.frame() |>
filter(Habitat != "passage")
p_zone_allherbs_B <-
th_b_nd_zone |>
ggplot(aes(x = Habitat,
y = median)) +
geom_pointrange(aes(ymin = lower,
ymax = upper),
shape = 21,
size = 1,
fatten = 3,
color = "#8AA17D",
fill = "#8AA17D") +
scale_y_continuous(expression(Biomass~(kg.150m^-2)),
limits = c(0, 8),
breaks = seq(0, 8, by = 2)) +
scale_x_discrete(name = "") +
theme_classic() +
ggtitle("Total herbivores") +
theme(axis.title.x=element_blank(),
axis.text.x=element_blank(),
axis.ticks.x=element_blank(),
axis.title.y = element_text(size = 15),
axis.text.y = element_text(size = 12),
plot.title = element_text(size = 18)) +
geom_image(data = tibble(Habitat = 2.8,
median = 7.5),
aes(image = "naso.png"),
size = 0.30) +
geom_image(data = tibble(Habitat = 2.8,
median = 5.8),
aes(image = "ctenochaetus.png"),
size = 0.30) +
geom_image(data = tibble(Habitat = 2,
median = 7.5),
aes(image = "scarus.png"),
size = 0.30) +
geom_image(data = tibble(Habitat = 2,
median = 5.8),
aes(image = "chlorurus.png"),
size = 0.30)
