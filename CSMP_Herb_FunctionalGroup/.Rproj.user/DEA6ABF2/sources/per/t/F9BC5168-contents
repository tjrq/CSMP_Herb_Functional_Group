####  Plot slope contrasts

```{r}
# prepare db
biom_slope_pair <-
  b_mod_herbs_2 |> emmeans(~ Aspect_descriptive,
                         type = "link") |> 
  pairs() |> 
  gather_emmeans_draws() |> 
  summarise(median_hdci(exp(.value),
                        .width = c(0.85, 0.95))) 

# plot
 p_biom_slope_pair <- ggplot() + 
  geom_pointrange(aes(y = y, 
                      x = contrast, 
                      ymin = ymin, 
                      ymax = ymax),
                  data = biom_slope_pair |> filter(.width == 0.85),
                  linewidth = 1.7) +
  geom_pointrange(aes(y = y, 
                      x = contrast, 
                      ymin = ymin, 
                      ymax = ymax),
                  data = biom_slope_pair |> filter(.width == 0.95),
                  pch = 21,
                  size = 1.2,
                  fill = "#8AA17D",
                  linewidth = 0.7) +
  geom_hline(yintercept = 1, 
             linetype = "dashed",
             color = "red",
             linewidth = 1) +
    coord_flip() +
  theme_classic() +
  scale_x_discrete(name = "") +
  scale_y_continuous(name = "",
                   trans = scales::log2_trans()) +
  ggtitle("Biomass") +
  theme(axis.title.x = element_text(size = 15),
        axis.text.x = element_text(size = 12),
        axis.title.y = element_blank(),
        axis.text.y = element_blank(),
        axis.ticks.y = element_blank(),
        plot.title = element_text(size = 18))
```

