# HERBIVORES

## Load model

```{r}
load("Model_Outputs/b_mod_herbs_2.Rdata")
```

## Exceedence probability

```{r}
b_mod_herbs_2 |> as_draws_df() |> 
  dplyr::select(matches("^b_.*")) |> 
  exp() |> 
  summarise_draws(median,
                  HDInterval::hdi,
                  Pl= ~mean(.x < 1),
                  Pg = ~mean(.x > 1)) |> 
  filter(Pl > 0.85 | 
           Pg > 0.85)
```

## DEPTH

### Newdata herbs

```{r}
depth_b_newdata <- with(fg_biom,
                 data.frame(Depth_m = seq(min(Depth_m),
                                          max(Depth_m),
                                          length = 100)))
```

### Predict herbs

```{r, cache=TRUE}
herbs_b_depth_pred <- 
  b_mod_herbs_2 |> 
  emmeans(~ Depth_m, 
          at = depth_b_newdata, 
          type = "link",
          rg.limit = 12000) |> 
  gather_emmeans_draws() |> 
  mutate(Exp_biom = exp(.value)) |> 
  dplyr::select(-.chain,
                -.iteration,
                -.value) |> 
  summarise_draws(median, 
                  HDInterval::hdi) |> 
  as.data.frame()
```

### Herbs depth plot

```{r}
p_depth_allherbs_B <-
herbs_b_depth_pred |> 
  ggplot(aes(y = median,
             x = Depth_m)) +
    geom_point(data = fg_biom,
             aes(y = herbs),
             size = 2.5, 
             shape = 21,
             color = "#8AA17D",
             fill = "#8AA17D",
             alpha = 0.3) +
  geom_line(linewidth = 2,
            color = "#8AA17D") +
  geom_ribbon(aes(ymin = lower,
                  ymax = upper),
              fill = "#8AA17D",
              color = "#8AA17D",
              alpha = 0.6) +
  scale_y_continuous(expression(Biomass~(kg.150m^-2)),
                       limits = c(0, 40),
  breaks = seq(0, 40, by = 10)) +
  scale_x_continuous(name = "",
                     breaks = seq(0, 100, by = 20)) +
  theme_classic() +
  ggtitle("Total herbivores") +
     theme(axis.title.x=element_blank(),
        axis.text.x=element_blank(),
        axis.ticks.x=element_blank(),
        axis.title.y = element_text(size = 15),
        axis.text.y = element_text(size = 12),
        plot.title = element_text(size = 18)) +
    geom_image(data = tibble(Depth_m = 90,
                           median = 38),
             aes(image = ("naso.png")),
             size = 0.30) +
  geom_image(data = tibble(Depth_m = 90,
                           median = 30),
             aes(image = ("ctenochaetus.png")),
             size = 0.30) +
   geom_image(data = tibble(Depth_m = 70,
                           median = 38),
             aes(image = ("scarus.png")),
             size = 0.30) +
   geom_image(data = tibble(Depth_m = 70,
                           median = 30),
             aes(image = ("chlorurus.png")),
             size = 0.30) +
  theme(legend.position = "none")
```

