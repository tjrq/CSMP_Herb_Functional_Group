# PLOT LENGTH

## std error of the mean

```{r}
std_error <- function(x) sd(x)/sqrt(length(x))
```

```{r}
p_mean_length <-
fg_biom_long |> 
  filter(Functional.Group == "browser" |
           Functional.Group == "cropper/grazer" |
           Functional.Group == "detritivore" |
           Functional.Group == "excavator" |
           Functional.Group == "scraper") |> 
  mutate(Depth_bin = factor(case_when(Depth_m < 11 ~ '10m',
                                      Depth_m >= 11  & Depth_m < 21 ~ '20m', 
                                      Depth_m >= 21  & Depth_m < 31 ~ '30m', 
                                      Depth_m >= 31  & Depth_m < 41 ~ '40m', 
                                      Depth_m >= 41  & Depth_m < 51 ~ '50m', 
                                      Depth_m >= 51  & Depth_m < 61 ~ '60m', 
                                      Depth_m >= 61  & Depth_m < 71 ~ '70m', 
                                      Depth_m >= 71  & Depth_m < 81 ~ '80m', 
                                      Depth_m >= 81  & Depth_m < 91 ~ '90m', 
                                    Depth_m >= 91  ~ '100m'), ordered = TRUE)) |> 
  mutate(Depth_bin = factor(Depth_bin,
         levels = c("10m",
                    "20m",
                    "30m",
                    "40m",
                    "50m",
                    "60m",
                    "70m",
                    "80m",
                    "90m",
                    "100m"))) |> 
  mutate(Functional.Group = recode(Functional.Group,
                                   browser = "Browser",
                                   `cropper/grazer` = "Cropper",
                                   detritivore = "Detritivore",
                                   excavator = "Excavator",
                                   scraper = "Scraper")) |> 
  group_by(Functional.Group,
           Depth_bin) |> 
  summarise(MEAN = mean(Length_cm),
            STDE = std_error(Length_cm)) |> 
  ggplot(aes(x = Depth_bin,
             y = MEAN)) +
  geom_pointrange(aes(ymin = MEAN - STDE,
                      ymax = MEAN + STDE,
                  color = Functional.Group)) +
  facet_wrap(~ Functional.Group,
             scales = "free") +
  scale_color_manual(values = c("#929FBD",
                                "#DDD487",
                                "#BFB59E",
                               "#E29297",
                               "#BFAECF")) +
  theme_classic() +
  theme(axis.text.x = element_text(angle = 90,
                                 vjust = 0.85,
                                 hjust = 0.70,
                                 size = 12),
        axis.title = element_text(size = 15),
        axis.text.y = element_text(size = 12),
        legend.position = "none",
        strip.text = element_text(size = 15)) +
  scale_y_continuous(expression(Length~(cm)))
```

